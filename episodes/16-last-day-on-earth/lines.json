[
 {"id": "16_s01", "char": "steve", "vo": true, "text": "[dry, wired] Two A.M. The news said World War THREE could start any day."},
 {"id": "16_s02", "char": "steve", "vo": true, "text": "[flat] Experts said: be PREPARED."},
 {"id": "16_s03", "char": "steve", "text": "[baffled, in the moment] Prepared for WHAT?"},
 {"id": "16_s04", "char": "steve", "vo": true, "text": "[calm, liberated] If the world ends tomorrow... nothing MATTERS."},
 {"id": "16_s05", "char": "steve", "vo": true, "text": "[breezy] Gym? CANCELLED."},
 {"id": "16_s06", "char": "steve", "vo": true, "text": "[breezy] Diet? GONE."},
 {"id": "16_s07", "char": "steve", "vo": true, "text": "[proud] Credit card? MAXED."},
 {"id": "16_s08", "char": "steve", "text": "[full rage] And ANOTHER thing, Gary — #@$%&!", "spoken": "[full rage] And ANOTHER thing, Gary —", "bleep_after": 0.6},
 {"id": "16_s10", "char": "steve", "vo": true, "text": "[groggy, content] Morning. Birds. SUNSHINE."},
 {"id": "16_s11", "char": "steve", "vo": true, "text": "[slowly dawning] No WAR."},
 {"id": "16_s12", "char": "steve", "text": "[dread, in the moment] ...Oh NO."},
 {"id": "16_s13", "char": "steve", "vo": true, "text": "[flat] The world didn't end. My JOB did."},
 {"id": "16_p14", "char": "penny", "text": "[crisp, flat, a small child] Rent is due Friday. That still MATTERS."}
