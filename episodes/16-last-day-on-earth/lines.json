[
 {
  "id": "16_s01",
  "char": "steve",
  "vo": true,
  "text": "[whispering, wide awake, a bit scared] Two A.M. The news said World War THREE could start any day."
 },
 {
  "id": "16_s02",
  "char": "steve",
  "vo": true,
  "text": "[whispers, nervous] Experts said: be PREPARED."
 },
 {
  "id": "16_s03",
  "char": "steve",
  "text": "[scoffs, too loud for 2 A.M.] Prepared for WHAT?"
 },
 {
  "id": "16_s04",
  "char": "steve",
  "vo": true,
  "text": "[slow realization] If the world ends tomorrow... [giggles] nothing MATTERS."
 },
 {
  "id": "16_s05",
  "char": "steve",
  "vo": true,
  "text": "[mischievously] Gym? CANCELLED."
 },
 {
  "id": "16_s06",
  "char": "steve",
  "vo": true,
  "text": "[mouth full, happy] Diet? GONE."
 },
 {
  "id": "16_s07",
  "char": "steve",
  "vo": true,
  "text": "[excited, almost singing] Credit card? MAXED!"
 },
 {
  "id": "16_s08",
  "char": "steve",
  "text": "[shouting, furious] And ANOTHER thing, Gary — #@$%&!",
  "spoken": "[shouting, furious] And ANOTHER thing, Gary —",
  "bleep_after": 0.6
 },
 {
  "id": "16_s10",
  "char": "steve",
  "vo": true,
  "text": "[happy stretch, quick] Morning. Birds. SUNSHINE."
 },
 {
  "id": "16_s11",
  "char": "steve",
  "vo": true,
  "text": "[confused, quietly] No... WAR?"
 },
 {
  "id": "16_s12",
  "char": "steve",
  "text": "[gasps, horrified whisper] ...Oh NO."
 },
 {
  "id": "16_s13",
  "char": "steve",
  "vo": true,
  "text": "[sighs, dead flat] The world didn't end. My JOB did."
 },
 {
  "id": "16_p14",
  "char": "penny",
  "text": "[cheerful but cold, matter-of-fact little girl] Rent is due Friday. That still MATTERS."
 }
